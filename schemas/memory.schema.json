{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/memory/1",
  "title": "MemoryRecord",
  "description": "Durable but untrusted knowledge. Must be re-verified against the repo before use. Writers must reject secrets and personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "scope", "kind", "title", "body", "source", "provenance", "created_at", "updated_at", "confidence"],
  "properties": {
    "schema": { "const": "memory/1" },
    "id": { "type": "string" },
    "scope": { "enum": ["project", "user", "team"] },
    "kind": { "enum": ["decision", "fact", "lesson", "context", "preference", "runbook", "handoff", "eval"] },
    "title": { "type": "string", "maxLength": 120 },
    "body": { "type": "string", "maxLength": 4000 },
    "source": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session_id": { "type": "string" },
        "agent": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "related_files": { "type": "array", "items": { "type": "string" } },
    "related_sessions": { "type": "array", "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "verified_at": { "type": "string", "format": "date-time" },
    "verified_against": { "type": "string", "description": "git_head at last verification." },
    "supersedes": { "type": "string" },
    "contradicts": { "type": "array", "items": { "type": "string" } },
    "stale": { "type": "boolean", "default": false }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/plan/2",
  "title": "Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tier", "requirements", "scope", "non_goals", "files", "phases", "risks", "rollback", "validation", "acceptance", "plan_hash"],
  "properties": {
    "schema": { "const": "plan/2" },
    "tier": { "enum": ["T0", "T1", "T2", "T3"] },
    "requirements": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "user_journeys": { "type": "array", "items": { "type": "string" } },
    "scope": { "type": "array", "items": { "type": "string" } },
    "non_goals": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "change"],
        "properties": {
          "path": { "type": "string" },
          "change": { "enum": ["add", "modify", "delete"] },
          "pattern_to_mirror": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "decision", "rationale"],
        "properties": {
          "name": { "type": "string" },
          "decision": { "enum": ["adopt", "extend", "compose", "build"] },
          "rationale": { "type": "string" }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "goal", "tests_first"],
        "properties": {
          "id": { "type": "string" },
          "goal": { "type": "string" },
          "tests_first": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["risk", "mitigation"],
        "properties": {
          "risk": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    },
    "security_plan": { "type": "array", "items": { "type": "string" } },
    "rollback": { "type": "string" },
    "validation": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "acceptance": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "plan_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of the canonical JSON of this document excluding plan_hash. Approvals bind to this value."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tier": { "enum": ["T2", "T3"] } } },
      "then": { "required": ["security_plan"], "properties": { "security_plan": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "tier": { "const": "T3" } } },
      "then": { "properties": { "rollback": { "minLength": 10 } } }
    }
  ]
}
